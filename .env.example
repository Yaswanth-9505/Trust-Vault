# Copy to .env for local use (never commit .env). In production set these in
# the host's environment settings instead.

TV_ENV=production
TV_DATABASE_PATH=/home/YOURUSER/trustvault-data/trustvault.db

# Two DIFFERENT 32-byte keys, base64. Generate each with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Losing TV_MASTER_KEY means losing every stored file. Back it up somewhere safe.
TV_MASTER_KEY=
TV_AUDIT_KEY=

TV_SECURE_COOKIES=1
TV_TRUSTED_PROXIES=1
# Shared demo accounts cannot change their own passwords while this is on.
TV_DEMO_MODE=1
# DELETE is safe on network storage (PythonAnywhere). Use WAL only on a local disk.
TV_SQLITE_JOURNAL=DELETE
